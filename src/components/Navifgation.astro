---
import ThemeToggle from './ThemeToggle.jsx'
import MobileMenu from './MobileMenu.jsx'
---

<nav class="border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-2">
          <svg class="h-8 w-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          <span class="text-xl font-bold text-foreground">Parquet Viewer</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-muted-foreground hover:text-foreground transition-colors">
          Home
        </a>
        <a href="/about" class="text-muted-foreground hover:text-foreground transition-colors">
          About
        </a>
        <ThemeToggle client:load />
      </div>

      <!-- Mobile Navigation -->
      <div class="md:hidden flex items-center space-x-2">
        <ThemeToggle client:load />
        <MobileMenu client:load />
      </div>
    </div>
  </div>
</nav>
